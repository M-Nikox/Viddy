# Viddy environment configuration (all values optional).
# Copy this file to ".env" and adjust. Loaded automatically at startup.

# PORT: HTTP port the server listens on (default 3000).
# PORT=3000

# MEDIA_DIR: Custom path to your media drive or folder
# (e.g. "E:\Media" on Windows or "/mnt/media" on Linux).
# If unset, defaults to "./media_storage" inside the app folder.
# Media is streamed in-place from this path — nothing is copied.
# MEDIA_DIR=./media_storage

# NODE_ENV: development|production. In production the compiled frontend in
# ./dist is served (run "npm run build" first). You can also start in
# production mode with "npm run start" regardless of this variable.
# NODE_ENV=development
